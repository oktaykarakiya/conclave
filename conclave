#!/usr/bin/env bash
# Conclave launcher: bootstraps a local venv on first run, then starts the daemon.
# Usage:
#   ./conclave                                   # serves on 0.0.0.0:8700
#   CONCLAVE_HOST=127.0.0.1 ./conclave           # restrict to loopback
#   CONCLAVE_PORT=9000 ./conclave                # custom port
#   CONCLAVE_HOME=/path/to/data ./conclave       # data dir (default ~/.local/share/conclave)
#   CONCLAVE_ENGINE=claude ./conclave            # default engine Claude Code (default: opencode)
#   CONCLAVE_OPENCODE_BIN=/path/to/opencode      # override opencode binary autodiscovery
#   CONCLAVE_CLAUDE_BIN=/path/to/claude          # override claude binary autodiscovery
#   PYTHON=python3.12 ./conclave                 # pick the interpreter used to build the venv
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
VENV="$HERE/.venv"
PYTHON="${PYTHON:-python3}"

if [ ! -x "$VENV/bin/python" ]; then
  if ! "$PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
    echo "[conclave] error: Python >= 3.12 is required (found: $("$PYTHON" --version 2>&1))." >&2
    echo "[conclave] install Python 3.12+ or run: PYTHON=python3.12 ./conclave" >&2
    exit 1
  fi
  echo "[conclave] creating virtualenv at $VENV ..."
  "$PYTHON" -m venv "$VENV"
  "$VENV/bin/python" -m pip install --quiet --upgrade pip
fi

# Install/refresh the package if it is missing or pyproject is newer than the marker.
MARKER="$VENV/.conclave-installed"
if [ ! -f "$MARKER" ] || [ "$HERE/pyproject.toml" -nt "$MARKER" ]; then
  echo "[conclave] installing dependencies ..."
  "$VENV/bin/python" -m pip install --quiet -e "$HERE"
  touch "$MARKER"
fi

# --- Engine selection (opencode-native by default) ---------------------------
# CONCLAVE_ENGINE picks the default engine; any agent whose model is "claude-code/<model>"
# runs on the Claude Code CLI regardless, so both engines are located when present.
export CONCLAVE_ENGINE="${CONCLAVE_ENGINE:-opencode}"

# opencode is frequently installed outside PATH (e.g. ~/.opencode/bin). Locate it once.
if [ -z "${CONCLAVE_OPENCODE_BIN:-}" ]; then
  if command -v opencode >/dev/null 2>&1; then
    CONCLAVE_OPENCODE_BIN="$(command -v opencode)"
  elif [ -x "$HOME/.opencode/bin/opencode" ]; then
    CONCLAVE_OPENCODE_BIN="$HOME/.opencode/bin/opencode"
  fi
fi
# Same for claude (native installer: ~/.local/bin; legacy npm-local: ~/.claude/local).
if [ -z "${CONCLAVE_CLAUDE_BIN:-}" ]; then
  if command -v claude >/dev/null 2>&1; then
    CONCLAVE_CLAUDE_BIN="$(command -v claude)"
  elif [ -x "$HOME/.local/bin/claude" ]; then
    CONCLAVE_CLAUDE_BIN="$HOME/.local/bin/claude"
  elif [ -x "$HOME/.claude/local/claude" ]; then
    CONCLAVE_CLAUDE_BIN="$HOME/.claude/local/claude"
  fi
fi
[ -n "${CONCLAVE_OPENCODE_BIN:-}" ] && export CONCLAVE_OPENCODE_BIN
[ -n "${CONCLAVE_CLAUDE_BIN:-}" ] && export CONCLAVE_CLAUDE_BIN

echo "[conclave] default engine: $CONCLAVE_ENGINE" >&2
echo "[conclave]   opencode:    ${CONCLAVE_OPENCODE_BIN:-not found}" >&2
echo "[conclave]   claude code: ${CONCLAVE_CLAUDE_BIN:-not found} (models: claude-code/<model>)" >&2
case "$CONCLAVE_ENGINE" in
  opencode) [ -n "${CONCLAVE_OPENCODE_BIN:-}" ] || echo "[conclave] warning: opencode not found — install it, set CONCLAVE_OPENCODE_BIN, or run CONCLAVE_ENGINE=claude ./conclave" >&2 ;;
  claude|claude-code) [ -n "${CONCLAVE_CLAUDE_BIN:-}" ] || echo "[conclave] warning: claude not found — install Claude Code or set CONCLAVE_CLAUDE_BIN" >&2 ;;
esac

exec "$VENV/bin/python" -m conclave.main "$@"
