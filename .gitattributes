# Force LF everywhere so a checkout on Windows (or a copy through it) can never
# break the bash launcher (`#!/usr/bin/env bash\r`) or the Python sources.
* text=auto eol=lf
conclave text eol=lf
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
# The committed SPA build (minified bundles) is generated: `git diff` prints one "Binary files ...
# differ" line per file instead of its text, so review diffs stay on the real change. Merges still
# merge it as text.
src/conclave/web/static/** -diff linguist-generated=true
